ENVIRONMENT=production
APP_SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
POSTGRES_DB=planning
POSTGRES_USER=planning
POSTGRES_PASSWORD=replace-with-a-long-random-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://planning:replace-with-a-long-random-password@postgres:5432/planning
REDIS_URL=redis://redis:6379/0
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=planning-kimi
ALLOWED_LLM_HOSTS=host.docker.internal,ollama
AUTH_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1,planning.local,api
CORS_ORIGINS=https://planning.local
PLANNING_WORKSPACE=/app/documents
PLANNING_WORKBOOK=/app/data/planning.xlsx
RATE_LIMIT_PER_MINUTE=60
ORTOOLS_SEARCH_WORKERS=4
RETRIEVAL_CPU_THREADS=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=64
