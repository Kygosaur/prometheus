# Only explicit loopback IP addresses are accepted.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=planning-kimi
PLANNING_WORKSPACE=documents
PLANNING_WEB_PORT=8010
RETRIEVAL_ENABLE_SEMANTIC=true
RETRIEVAL_LOCAL_FILES_ONLY=true
RETRIEVAL_CPU_THREADS=2
ORTOOLS_SEARCH_WORKERS=4
PLANNING_DATABASE=data/planning_history.db
PLANNING_WORKBOOK=data/planning.xlsx
AUTH_ENABLED=false
# To enable authentication, set AUTH_ENABLED=true and configure these privately:
# APP_SECRET_KEY=at-least-32-random-characters
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=at-least-12-characters
